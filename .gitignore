# — Dépendances —
node_modules/
.pnpm-store/

# — Build —
dist/
build/
*.tsbuildinfo

# — Secrets et environnement (lot 1 §4 : aucun secret réel dans le dépôt) —
.env
.env.*
!.env.example
# Gabarit du VPS : aucune valeur réelle, mais `.env.*` l'aurait ignoré et
# personne ne se serait demandé où il était passé.
!.env.prod.example
.env.tag
secrets/

# — Production : ce que le serveur écrit, jamais le dépôt —
infra/nginx/logs/
infra/certbot/

# — Prisma : client généré (regénéré par `prisma generate`, voir L10 §2.0) —
api/src/generated/

# — Tests —
coverage/
.nyc_output/
test-results/
playwright-report/

# — Médias hors dépôt (volume Docker « storage », L7 §1) —
storage/

# — Journaux —
*.log
npm-debug.log*
pnpm-debug.log*

# — Éditeurs et OS —
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# — Claude Code —
# `settings.local.json` est personnel : permissions accordées sur CE poste,
# chemins locaux. Le reste de `.claude/` est partagé volontairement —
# `launch.json` décrit comment lancer le serveur de développement, et une
# session cloud en a besoin autant que vous.
.claude/settings.local.json
Thumbs.db

# — Photos du héros, rapatriées d'Unsplash —
# Images de remplacement, régénérables par
#     node web/scripts/telecharger-heros.mjs
# Elles pèsent 2,7 Mo et ne sont pas notre propriété : le dépôt n'a pas à les
# porter. À remplacer par les visuels du client, qui seront versionnés.
web/public/heros/

# Photos de galerie, rapatriées d'Unsplash — régénérables par
#     node web/scripts/telecharger-galerie.mjs
web/public/galerie/
