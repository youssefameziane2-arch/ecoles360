# =============================================================================
#  écoles360 — variables d'environnement
# -----------------------------------------------------------------------------
#  Copier ce fichier en `.env` puis ajuster :   cp .env.example .env
#
#  `.env` est ignoré par git (lot 1 §4) — AUCUN SECRET RÉEL ne doit être commité.
#  En production les mêmes clés vivent dans /srv/ecoles360/.env.prod (chmod 600),
#  et le mot de passe root MySQL passe par un secret Docker monté en fichier
#  plutôt que par une variable d'environnement (livrable 14 §6).
#
#  Ce fichier est lu deux fois :
#    1. par Docker Compose, pour interpoler ${...} dans docker-compose.dev.yml ;
#    2. par l'API (@nestjs/config), au démarrage.
#  Les valeurs marquées « hôte » sont celles d'une exécution hors conteneur ;
#  docker-compose.dev.yml les surcharge par les noms de services du réseau
#  interne (mysql, redis) — voir la section `environment:` du service `api`.
# =============================================================================


# -----------------------------------------------------------------------------
#  Application
# -----------------------------------------------------------------------------

# Environnement d'exécution : development | test | production
# Conditionne le niveau de détail des erreurs et l'exposition de /api/docs.
NODE_ENV=development

# Port d'écoute de l'API NestJS. Le conteneur `api` publie 3000 sur 127.0.0.1.
PORT=3000

# Version applicative exposée par GET /api/v1/health et par la sonde externe
# UptimeRobot (livrable 14 §5). En production, la CI la positionne au SHA de
# commit qui tague l'image (livrable 14 §3) — une réponse de sonde identifie
# donc sans ambiguïté la version en service.
APP_VERSION=0.1.0

# Niveau de journalisation Nest : error | warn | log | debug | verbose
LOG_LEVEL=log


# -----------------------------------------------------------------------------
#  Base de données — MySQL 8 (InnoDB, utf8mb4_unicode_ci)
# -----------------------------------------------------------------------------

# Chaîne de connexion Prisma (livrable 10 §2.0 : datasource db { url = env("DATABASE_URL") }).
# Valeur « hôte » : exécution de l'API hors conteneur (livrable 14 §1).
# Dans le conteneur `api`, docker-compose.dev.yml la surcharge en
#   mysql://ecoles360:motdepasse_dev@mysql:3306/ecoles360_dev
DATABASE_URL=mysql://ecoles360:motdepasse_dev@127.0.0.1:3306/ecoles360_dev

# Initialisation du conteneur mysql:8 — doit rester cohérent avec DATABASE_URL.
MYSQL_DATABASE=ecoles360_dev
MYSQL_USER=ecoles360
MYSQL_PASSWORD=motdepasse_dev

# Mot de passe root du conteneur MySQL de développement uniquement.
# En production : secret Docker monté en fichier (livrable 14 §2.1, §6).
MYSQL_ROOT_PASSWORD=root_dev

# Port publié par le conteneur mysql, lié à la boucle locale exclusivement
# (livrable 7 §6 : MySQL n'est jamais joignable depuis l'extérieur).
MYSQL_PORT=3306


# -----------------------------------------------------------------------------
#  Redis 7 — sessions, files BullMQ, cache, compteurs de limitation de débit
# -----------------------------------------------------------------------------

# Valeur « hôte » ; surchargée en redis://redis:6379/0 dans le conteneur `api`.
# Convention de bases (livrable 13 §2.2) :
#   0  → développement et production
#   15 → tests (vidée par FLUSHDB entre les suites, jamais la base 0)
REDIS_URL=redis://127.0.0.1:6379/0

# Port publié par le conteneur redis, lié à la boucle locale exclusivement.
REDIS_PORT=6379


# -----------------------------------------------------------------------------
#  Sonde de santé — GET /api/v1/health
# -----------------------------------------------------------------------------

# Délai maximal accordé à CHAQUE dépendance avant de la déclarer en échec.
# Doit rester nettement sous le `timeout` du HEALTHCHECK Docker (5 s) et sous
# l'intervalle de la sonde UptimeRobot, sans quoi un incident MySQL ferait
# expirer la requête au lieu de renvoyer un 503 exploitable (livrable 14 §2.1).
HEALTH_CHECK_TIMEOUT_MS=2000


# -----------------------------------------------------------------------------
#  Documentation d'API — /api/docs (OpenAPI 3, livrable 11 §1)
# -----------------------------------------------------------------------------

# Exposition de Swagger. Vide ou absent : actif hors production, inactif en
# production. Le livrable 11 §1 réserve l'accès au Super Admin hors
# développement — la garde arrivera avec le module d'authentification
# (voir docs/BACKLOG.md, B-07).
SWAGGER_ENABLED=true


# -----------------------------------------------------------------------------
#  Sessions Passport — livrable 11 §2
# -----------------------------------------------------------------------------

# Signe l'identifiant de session. AU MOINS 32 CARACTÈRES, et propre à chaque
# environnement : qui le connaît peut forger une session valide pour n'importe
# quel compte. En production il vit dans /srv/ecoles360/.env.prod (chmod 600),
# jamais dans le dépôt (livrable 14 §6). Génération :  openssl rand -hex 32
SESSION_SECRET=secret-de-developpement-a-remplacer-32-caracteres-minimum

# Préfixe des clés de session dans Redis. Sert aussi à la révocation ciblée
# (RG25) : AuthService balaie ce préfixe pour détruire les sessions d'un compte.
SESSION_PREFIX=ecoles360:sess:

# =============================================================================
#  À VENIR — lots ultérieurs. Laissés commentés pour mémoire : ces clés sont
#  exigées par les livrables mais aucun code du lot 1 ne les lit.
# =============================================================================


# — Seeders (livrable 10 §3) — lot 2, fournis par les secrets GitHub en CI
# SEED_ADMIN_PASSWORD=
# SEED_SECRETAIRE_PASSWORD=
# SEED_ETABLISSEMENT_PASSWORD=

# — SMTP transactionnel (file BullMQ `mail`, livrable 11 §6)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

# — Stockage des médias (volume Docker `storage`, livrable 7 §1)
# STORAGE_ROOT=/app/storage

# — Déploiement (livrable 14 §4) : tag d'image, écrit par deploy.sh dans .env.tag
# TAG=
# GH_ORG=
