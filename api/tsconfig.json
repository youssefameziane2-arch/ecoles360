{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2023"],
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* TypeScript strict — imposé par le lot 1 §2. Aucun assouplissement :
       `strict` implique noImplicitAny, strictNullChecks, strictFunctionTypes,
       strictBindCallApply, strictPropertyInitialization, noImplicitThis et
       useUnknownInCatchVariables. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    /* strictPropertyInitialization est incompatible avec l'injection par
       décorateur des DTO class-validator (livrable 11 §5) : les propriétés sont
       affectées par class-transformer, pas par le constructeur. */
    "strictPropertyInitialization": false,

    /* Alias `@/…` → `src/…` — convention des tests du livrable 13 §2.
       Le code de `src/` utilise des imports relatifs (livrable 11 §4) pour que
       `dist/` reste exécutable sans réécriture de chemins. */
    "paths": {
      "@/*": ["src/*"]
    }
  },
  /**
   * Surveillance des fichiers par SONDAGE, et non par événements système.
   *
   * Sous Docker Desktop pour Windows, les modifications faites sur l'hôte ne
   * remontent PAS en événements inotify dans le conteneur Linux : le montage
   * passe par une passerelle qui ne les propage pas. Sans sondage,
   * `nest start --watch` ne recompile jamais, et le rechargement à chaud
   * annoncé par docker-compose.dev.yml est une promesse vide — il faut
   * redémarrer le conteneur à chaque modification.
   *
   * Le coût est un réveil périodique du processus ; le bénéfice est que le
   * développement fonctionne réellement sur les trois systèmes.
   */
  "watchOptions": {
    "watchFile": "priorityPollingInterval",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "dynamicPriority"
  },

  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
