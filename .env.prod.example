# =============================================================================
#  écoles360 — gabarit du .env.prod du VPS
#  Livrable 14 §6
# -----------------------------------------------------------------------------
#  CE FICHIER EST UN GABARIT ET NE PORTE AUCUNE VALEUR RÉELLE. Le vrai
#  `.env.prod` vit sur le serveur, à /srv/ecoles360/.env.prod, en chmod 600,
#  propriétaire `deploy`, et N'ENTRE JAMAIS DANS LE DÉPÔT.
#
#      cp .env.prod.example .env.prod && chmod 600 .env.prod
#      # puis renseigner chaque valeur
#
#  Les deux mots de passe MySQL ne sont PAS ici : ils passent par des secrets
#  Docker montés en fichier (./secrets/*.txt), jamais par l'environnement, qui
#  se lit dans `docker inspect`.
# =============================================================================

# --- Version déployée -------------------------------------------------------
# Écrits par infra/deploy.sh dans .env.tag, pas à la main.
GH_ORG=votre-organisation-github
TAG=sha-du-commit-valide-par-la-ci

# --- Base de données --------------------------------------------------------
MYSQL_DATABASE=ecoles360_prod
MYSQL_USER=ecoles360
# Le mot de passe doit être IDENTIQUE à ./secrets/mysql_app.txt : MySQL le lit
# dans le fichier pour créer le compte, l'API le lit ici pour s'y connecter.
DATABASE_URL=mysql://ecoles360:MOT_DE_PASSE_APPLICATIF@mysql:3306/ecoles360_prod

# --- Redis ------------------------------------------------------------------
# Base 0 en production. La 15 est réservée aux tests (livrable 13 §2.2).
REDIS_URL=redis://redis:6379/0

# --- Application ------------------------------------------------------------
NODE_ENV=production
PORT=3000

# 32 caractères au minimum — l'API refuse de démarrer en deçà. À tirer au sort,
# jamais à choisir :  openssl rand -base64 48
SESSION_SECRET=

# Renseigné par le déploiement au SHA mis en service ; /api/v1/health le rend,
# ce qui permet de savoir quelle version répond sans ouvrir de session SSH.
APP_VERSION=

# Origine publique — sert aux liens absolus des courriels et du plan de site.
APP_URL=https://ecoles360.com

# --- Comptes semés ----------------------------------------------------------
# NE PAS RENSEIGNER EN PRODUCTION. Le semis de démonstration ne tourne jamais
# en production (RG14, RG15) : ces variables n'ont de sens qu'en développement
# et en staging. Laissées vides ici pour que leur absence soit un choix lisible
# et non un oubli.
SEED_ADMIN_PASSWORD=
SEED_SECRETAIRE_PASSWORD=
SEED_ETABLISSEMENT_PASSWORD=
